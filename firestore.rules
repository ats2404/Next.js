/**
 * @fileoverview Firestore Security Rules for the ATS Calculator application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. Each user has full control
 * over their own data, and no user can access another user's data unless explicitly
 * granted through a shared access mechanism (which is not present in this version).
 *
 * Data Structure:
 * - Users are stored in `/users/{userId}`.
 * - Themes are stored in `/users/{userId}/themes/{themeId}`.
 *   Each theme document contains a `userId` field that MUST match the `userId`
 *   in the path. This is a critical denormalization step for authorization.
 *
 * Key Security Decisions:
 * - User listing is disabled.
 * - All writes are protected by authorization checks.
 * - The `userId` field within a `Theme` document MUST match the `userId` in the
 *   path for `create` and MUST be immutable on `update`.
 *
 * Denormalization for Authorization:
 * The `Theme` documents contain a denormalized `userId` field. This allows rules
 * to validate ownership without performing costly `get()` operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects user profile information. Only the user themselves can read or write their profile.
     * @path /users/{userId}
     * @allow (create) - User 'user_abc' can create their profile if request.auth.uid == 'user_abc'.
     * @allow (get, update, delete) - User 'user_abc' can read, update, or delete their profile.
     * @deny (create) - User 'user_xyz' cannot create a profile with ID 'user_abc'.
     * @deny (get, update, delete) - User 'user_xyz' cannot read, update, or delete the profile of 'user_abc'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      // Is the user signed in?
      function isSignedIn() {
        return request.auth != null;
      }

      // Is the user the owner of the document?
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Is the user the owner of the document, and does the document already exist?
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      // Allow a user to create their own user document.
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;

      // Allow a user to read their own user document.
      allow get: if isOwner(userId);

      // Allow a user to update their own user document, enforcing immutability of the id field.
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;

      // Allow a user to delete their own user document.
      allow delete: if isExistingOwner(userId);

      // Prevent anyone from listing all users.
      allow list: if false;
    }

    /**
     * @description Manages user-defined themes. Ensures only the owner can create, read, update, or delete their themes.
     * @path /users/{userId}/themes/{themeId}
     * @allow (create) - User 'user_abc' can create a theme if request.auth.uid == 'user_abc' and request.resource.data.userId == 'user_abc'.
     * @allow (get, update, delete) - User 'user_abc' can read, update, or delete their theme.
     * @deny (create) - User 'user_xyz' cannot create a theme for 'user_abc'.
     * @deny (get, update, delete) - User 'user_xyz' cannot read, update, or delete the theme of 'user_abc'.
     * @principle Enforces document ownership and validates relational integrity.
     */
    match /users/{userId}/themes/{themeId} {
      // Is the user signed in?
      function isSignedIn() {
        return request.auth != null;
      }

      // Is the user the owner of the document?
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Is the user the owner of the document, and does the document already exist?
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      // Allow a user to create a theme, if the userId matches the path.
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;

      // Allow a user to read their own theme.
      allow get: if isOwner(userId);

      // Allow a user to update their own theme, enforcing immutability of the userId field.
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;

      // Allow a user to delete their own theme.
      allow delete: if isExistingOwner(userId);

      // Allow a user to list their own themes.
      allow list: if isOwner(userId);
    }
  }
}